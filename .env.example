# --- Database ---------------------------------------------------------------
# MongoDB Atlas (recommended, free M0): paste your SRV string here
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/kanban
MONGODB_DB=kanban

# --- Auth -------------------------------------------------------------------
# openssl/rand: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-random-32-bytes

# --- Cloud storage (REQUIRED - uploads are cloud-only) -----------------------
# Uploads go through presigned S3-compatible PUTs. Two supported providers
# (the FIRST complete set wins; configured driver order below):
#
# A) Cloudflare R2: set ALL four R2_* values.
# B) Backblaze B2 (free tier friendly: 10 GB storage + 1 GB/day downloads,
#    no credit card needed): set the three B2_* values. B2_REGION defaults
#    to "us-west-004" - your bucket's S3 endpoint region id, e.g. find it in
#    Bucket > Dashboard ("Endpoint": https://s3.<region>.backblazeb2.com).
#    B2 key = applicationKeyID (B2_KEY_ID) + applicationKey (B2_APPLICATION_KEY).
#
# Without ANY provider the app refuses uploads with a calm "uploads are
# disabled" 503 toast (by design - there is NO local upload fallback).
# Legacy files in /data/uploads remain served auth-checked through
# /api/files/[...key].

# A) Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# B) Backblaze B2 (S3-compatible)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# Optional; defaults to us-west-004 when empty
B2_REGION=

# --- Storage serving ---------------------------------------------------------
# Optional public bucket URL (e.g. https://cdn.example.com for R2 or
# https://f<nnn>.backblazeb2.com/file/<bucket> for B2); leave empty to serve
# ALL files auth-checked through /api/files/[...key].
R2_PUBLIC_BASE=
B2_PUBLIC_BASE=

# --- SEO surfaces (robots.ts / sitemap.ts / OG metadata) ---------------------
# Set in production (e.g. https://dymticket.example.com); defaults to
# http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=

# --- AI content review (optional, admin/team ticket quality suggestions) ----
# Google AI Studio key. When absent, the AI button degrades to a calm
# "maintenance" toast - no other behavior changes. Read-only suggestions only.
GEMINI_API_KEY=
# Primary model override (default: gemini-2.0-flash; cheap lite models
# are free-tier friendly, e.g. gemini-3.1-flash-lite)
GEMINI_MODEL=
# Optional LIVE ROTATION chain (comma-separated, primary first).
# Free-tier quota is PER MODEL: when the primary hits its rate limit
# (429)/is unavailable, the next candidate serves the request instead of
# failing. 400/401/403 (key/request problems) never rotate - calm 503.
GEMINI_MODEL_FALLBACKS=
