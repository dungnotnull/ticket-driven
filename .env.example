# --- Database ---------------------------------------------------------------
# MongoDB Atlas (recommended, free M0): paste your SRV string here
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/kanban
MONGODB_DB=kanban

# --- Auth -------------------------------------------------------------------
# openssl/rand: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-random-32-bytes

# --- Cloudflare R2 (REQUIRED - uploads are cloud-only) -----------------------
# Uploads go through presigned R2 PUTs and REQUIRE all four R2_* values below.
# Without them the app refuses uploads with a calm "uploads are disabled"
# 503 toast (by design - there is NO local upload fallback). Legacy files in
# /data/uploads remain served auth-checked through /api/files/[...key].
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Storage serving ---------------------------------------------------------
# Optional public bucket URL (e.g. https://cdn.example.com); leave empty to
# serve ALL files (even R2 ones) auth-checked through /api/files/[...key].
R2_PUBLIC_BASE=

# --- SEO surfaces (robots.ts / sitemap.ts / OG metadata) ---------------------
# Set in production (e.g. https://dymticket.example.com); defaults to
# http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=

# --- AI content review (optional, admin/team ticket quality suggestions) ----
# Google AI Studio key. When absent, the AI button degrades to a calm
# "maintenance" toast - no other behavior changes. Read-only suggestions only.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
GEMINI_MODEL=
